e080b08c9bff1ed79790b537a27e93012163af07ba17806e786de9909e6fea65596e25a4a8674bde3614cff5a06b56febbbd2852cc25f92858d430f2e957c171  0001-output-fade-to-and-from-black-on-power-save.patch
"
