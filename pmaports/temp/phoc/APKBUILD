# Forked from Alpine to fade the screen to and from black on power save
# (power button), like other phone platforms. Upstream:
# https://gitlab.gnome.org/World/Phosh/phoc
# Keep the version in step with phosh from Alpine (edge has 0.58.0).
maintainer="Kieran Drewett <kieran@drewett.dev>"
pkgname=phoc
_pkgver=0.58.0
pkgver=9999$_pkgver
pkgrel=1
pkgdesc="wlroots based Phone compositor for the Phosh shell"
arch="all"
url="https://gitlab.gnome.org/World/Phosh/phoc"
license="GPL-3.0-only"
depends="
	$pkgname-schemas
	dbus
	gsettings-desktop-schemas
	mutter-schemas
	"
_wlrootsmakedepends="
	eudev-dev
	glslang
	hwdata-dev
	libcap-dev
	libdisplay-info-dev
	libseat-dev
	libxcb-dev
	xcb-util-image-dev
	xcb-util-renderutil-dev
	xcb-util-wm-dev
	xkeyboard-config-dev
	xwayland-dev
	"
makedepends="
	glib-dev
	gmobile-dev
	gnome-desktop-dev
	json-glib-dev
	libdrm-dev
	libinput-dev
	libxkbcommon-dev
	mesa-dev
	meson
	pixman-dev
	py3-docutils
	wayland-dev
	wayland-protocols
	$_wlrootsmakedepends
	"
subpackages="
	$pkgname-dbg
	$pkgname-doc
	$pkgname-lang
	$pkgname-schemas::noarch
	"
options="!check" # Needs fullblown EGL
source="https://sources.phosh.mobi/releases/phoc/phoc-$_pkgver.tar.xz
	0001-output-fade-to-and-from-black-on-power-save.patch
	0002-output-shield-drop-the-animation-before-the-rest-on-finalize.patch
	"
replaces="wlroots-phosh"
builddir="$srcdir/$pkgname-$_pkgver"

prepare() {
	default_prepare

	# keep in sync with diff_files in subprojects/wlroots.wrap
	local p
	for p in \
		text-input-v2/0001-text-input-v3-Introduce-version.patch \
		text-input-v2/0002-text-input-Add-version-2-events.patch \
		text-input-v2/0003-text-input-v3-Add-version-2-requests.patch \
		text-input-v2/0004-text-input-v3-Bump-protocol-version-to-2.patch \
		0001-Revert-layer-shell-error-on-0-dimension-without-anch.patch
	do
		patch -Np1 < subprojects/packagefiles/wlroots/$p \
			-d subprojects/wlroots-0.20.x
	done
}

build() {
	abuild-meson \
		-Db_lto=true \
		-Dembed-wlroots=enabled \
		-Dman=true \
		-Dtests=false \
		--default-library=static \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir/" meson install --no-rebuild -C output
	install -Dm755 tools/scale-to-fit \
		-t "$pkgdir"/usr/bin

	# remove unneeded wlroots dev. files
	rm -r "$pkgdir"/usr/include
	rm -r "$pkgdir"/usr/lib/libwlroots-*.a
	rm -r "$pkgdir"/usr/lib/pkgconfig
}

schemas() {
	pkgdesc="$pkgdesc (schemas)"
	depends=

	amove usr/share/glib-2.0/schemas
}

