# Temporary package: scrcpy-compatible server for the Pixel 4a 5G (bramble).
# Stock scrcpy pushes scrcpy-server.jar and runs it with Android's app_process.
# The app_process shim here runs the native wlr-screencopy/x264/uinput server
# instead, so the scrcpy client works unchanged over adb.
maintainer="Kieran Drewett <kieran@drewett.dev>"
pkgname=scrcpy-server
pkgver=0.1.0
pkgrel=2
pkgdesc="Native scrcpy server for postmarketOS (wlr-screencopy, x264, uinput), with an app_process shim"
url="https://github.com/Genymobile/scrcpy"
arch="aarch64"
license="GPL-3.0-or-later"
depends="x264-libs wayland-libs-client"
makedepends="wayland-dev x264-dev wlr-protocols"
install="$pkgname.post-install"
options="!check" # No test suite for the native server
source="scrcpy_server.c
	app_process
	71-scrcpy-uinput.rules
	"

build() {
	cd "$srcdir"
	local wlr=/usr/share/wlr-protocols/unstable/wlr-screencopy-unstable-v1.xml
	wayland-scanner client-header "$wlr" wlr-screencopy-unstable-v1-client-protocol.h
	wayland-scanner private-code "$wlr" wlr-screencopy-unstable-v1-protocol.c
	${CC:-gcc} ${CFLAGS:--O2} -std=gnu11 -Wall -Wextra -Wno-unused-parameter \
		-Wno-missing-field-initializers -I. -o scrcpy-server \
		"$srcdir"/scrcpy_server.c wlr-screencopy-unstable-v1-protocol.c \
		-lwayland-client -lx264 -lpthread -lm
}

package() {
	install -Dm755 "$srcdir"/scrcpy-server "$pkgdir"/usr/bin/scrcpy-server
	install -Dm755 "$srcdir"/app_process "$pkgdir"/usr/bin/app_process
	install -Dm644 "$srcdir"/71-scrcpy-uinput.rules \
		"$pkgdir"/usr/lib/udev/rules.d/71-scrcpy-uinput.rules
}

