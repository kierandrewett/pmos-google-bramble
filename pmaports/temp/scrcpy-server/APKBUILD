68ef4e05fb4f6b9d5db4cac4e291d61cc3f55d88885e551b77b675ccc559e487fd0bf03caf35cc936b3a82735b9524a9eeef7b2d82cd539282ca2cc4d0e0b92a  app_process
216b1dc48ce652896249b203a4a5c52d7a99ebef691c28d9af3e9dcbd4685c1b748deef257ab71f7ddbdf86ab6e0a7eee4af494d4680c1a0f209c07639d55402  71-scrcpy-uinput.rules
"
