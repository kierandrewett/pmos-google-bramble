92b57e2a58153ef5d2aa4f7cff7eff7b872631069d30ed6ca965b66c702eae0af9fd88225d740f699b18938b99c09fcb5dd2d3315a5402331bfc58887e111e8c  busybox.patch
b8a4b212823f8f24011b45250b090961526fbf7c7448088725310212cfdfe30a8f819858cd4d714e22d6b501b870dcbfe22a5758ee5a86160d765a887605a566  python-for-tests.patch
"
