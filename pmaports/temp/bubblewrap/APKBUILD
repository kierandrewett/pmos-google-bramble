# Forked from Alpine: Alpine builds bwrap for kernel 6.18 and later, which
# drops the fallbacks for kernels without openat2(2) and the new mount API.
# On the downstream 4.19 kernel of google-bramble every bind mount then
# fails with "Can't open source ...: Function not implemented", and with
# PID namespaces enabled glycin's sandbox check passes, so image loading
# (icons in the on-screen keyboard) breaks. Upstream:
# https://github.com/containers/bubblewrap
maintainer="Kieran Drewett <kieran@drewett.dev>"
pkgname=bubblewrap
_pkgver=0.13.1
pkgver=9999$_pkgver
pkgrel=0
pkgdesc="Unprivileged sandboxing tool"
url="https://github.com/containers/bubblewrap"
arch="all"
license="LGPL-2.1-or-later"
# check: Requires unprivileged user namespaces (not available in CI)
options="!check"
makedepends="
	docbook-xsl
	libcap-dev
	libcap-static
	muon
	"
checkdepends="
	cmd:findmnt
	cmd:getpcaps
	python3
	"
subpackages="
	$pkgname-static
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	"
source="$pkgname-$_pkgver.tar.gz::https://github.com/containers/bubblewrap/archive/v$_pkgver.tar.gz
	busybox.patch
	python-for-tests.patch
	"
builddir="$srcdir/$pkgname-$_pkgver"

build() {
	# Oldest kernel this package has to support: the downstream 4.19
	# kernels in pmaports.
	_linuxltsver="4.19.0"

	abuild-muon \
		-Dassume_kernel="$_linuxltsver" \
		-Dman=disabled \
		-Dtests=false \
		-Dc_link_args="$LDFLAGS -static" \
		-Dprefer_static=true \
		output-static
	ninja -C output-static

	abuild-muon \
		-Dassume_kernel="$_linuxltsver" \
		-Dman=enabled \
		-Dtests="$(want_check && echo true || echo false)" \
		output
	ninja -C output
}

check() {
	BWRAP_MUST_WORK=1 muon -C output test
}

package() {
	DESTDIR="$pkgdir" muon -C output install
}

static() {
	pkgdesc="$pkgdesc (static binary)"
	depends=""

	install -Dvm755 "$builddir"/output-static/bwrap \
		"$subpkgdir"/usr/bin/bwrap.static
}

