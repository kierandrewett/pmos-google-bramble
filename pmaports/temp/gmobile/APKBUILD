# Forked from Alpine to add the Google Pixel 4a (5G) display panel, so
# Phosh keeps the top bar clear of the punch-hole camera.
# Upstream: https://gitlab.gnome.org/World/Phosh/gmobile (data/devices)
maintainer="Kieran Drewett <kieran@drewett.dev>"
pkgname=gmobile
_pkgver=0.7.4
pkgver=9999$_pkgver
pkgrel=0
pkgdesc="Functions useful in mobile related, glib based projects"
url="https://gitlab.gnome.org/World/Phosh/gmobile"
arch="all"
license="GPL-3.0-only"
makedepends="
	meson
	glib-dev
	json-glib-dev
	gobject-introspection-dev
	vala
	"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	$pkgname-examples
	$pkgname-udev
	"
replaces="phoc"
source="https://sources.phosh.mobi/releases/gmobile/gmobile-$_pkgver.tar.xz
	0001-data-Add-Google-Pixel-4a-5G.patch
	"
builddir="$srcdir/gmobile-$_pkgver"

build() {
	abuild-meson build
	meson compile -C build
}

check() {
	meson test -C build
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

examples() {
	pkgdesc="$pkgdesc (examples)"
	depends="phoc phosh"

	amove usr/bin
}
