# Temporary package: standalone Linux build of AOSP adbd 36.0.1 for the
# Pixel 4a 5G (bramble). Alpine and postmarketOS do not ship the AOSP adb
# daemon for Linux (the adbd package in the repos is art_standalone, a
# different project). The -openrc subpackage adds a FunctionFS adb function
# to the USB gadget beside ncm.usb0 and a TCP listener on the USB network
# address only (see /etc/conf.d/adbd).
# Upstream: https://github.com/happyme531/standalone-linux-adbd (pinned below)
maintainer="Kieran Drewett <kieran@drewett.dev>"
pkgname=adbd
pkgver=36.0.1
pkgrel=2
pkgdesc="Android Debug Bridge daemon, standalone Linux build (USB FunctionFS and TCP)"
url="https://github.com/happyme531/standalone-linux-adbd"
arch="aarch64"
license="Apache-2.0"
makedepends="cmake linux-headers ninja patch xz"
subpackages="$pkgname-openrc"
# Part of the google-bramble port: install it with the device package.
install_if="device-google-bramble"
options="!check" # No test suite for the daemon-only build

_standalone=bdb5cdc4b516b3bc71fd2b805bc36190041a9393
_brotli=ed738e842d2fbdf2d6459e39267a633c4a9b2f5d
_lz4=ebb370ca83af193212df4dcbadcc5d87bc0de2f0
_zstd=f8745da6ff1ad1e7bab384bd1f9d742439278e99

builddir="$srcdir/standalone-linux-adbd-$_standalone"

# The AOSP sources (adb, core, libbase, logging, fmtlib) come from the
# android-tools $pkgver release tarball: the same commits the standalone tree
# pins, with its musl/Linux patches already applied, in a file that does not
# change between downloads (googlesource archives are generated on the fly
# and their checksums change). prepare() unpacks it all into vendor/.
noextract="android-tools-$pkgver.tar.xz brotli-$_brotli.tar.gz
	lz4-$_lz4.tar.gz zstd-$_zstd.tar.gz"

source="standalone-linux-adbd-$_standalone.tar.gz::https://github.com/happyme531/standalone-linux-adbd/archive/$_standalone.tar.gz
	https://github.com/nmeum/android-tools/releases/download/$pkgver/android-tools-$pkgver.tar.xz
	brotli-$_brotli.tar.gz::https://github.com/google/brotli/archive/$_brotli.tar.gz
	lz4-$_lz4.tar.gz::https://github.com/lz4/lz4/archive/$_lz4.tar.gz
	zstd-$_zstd.tar.gz::https://github.com/facebook/zstd/archive/$_zstd.tar.gz
	adb-tcp-bind.diff
	adbd.initd
	adbd.confd
	adbd-openrc.post-install
	"

prepare() {
	default_prepare

	local v="$builddir/vendor" d

	mkdir -p "$v/third_party/brotli" "$v/third_party/lz4" "$v/third_party/zstd"
	tar -xJf "$srcdir/android-tools-$pkgver.tar.xz" -C "$srcdir"
	for d in adb core libbase logging fmtlib; do
		rm -rf "${v:?}/$d"
		mv "$srcdir/android-tools-$pkgver/vendor/$d" "$v/$d"
	done
	tar -xzf "$srcdir/brotli-$_brotli.tar.gz" -C "$v/third_party/brotli" --strip-components=1
	tar -xzf "$srcdir/lz4-$_lz4.tar.gz" -C "$v/third_party/lz4" --strip-components=1
	tar -xzf "$srcdir/zstd-$_zstd.tar.gz" -C "$v/third_party/zstd" --strip-components=1

	# The release tarball already has the android-tools patches. Apply the
	# ones the standalone tree adds on top (Linux adbd: TCP daemon, FunctionFS
	# USB, abstract sockets), then our TCP bind patch.
	local p
	for p in "$builddir"/patches/adb/0029-*.patch \
		"$builddir"/patches/adb/0030-*.patch \
		"$builddir"/patches/adb/0031-*.patch \
		"$srcdir"/adb-tcp-bind.diff; do
		patch -p1 -d "$v/adb" -i "$p"
	done
}

build() {
	cmake -G Ninja -B output -S "$builddir" \
		-DCMAKE_BUILD_TYPE=Release \
		-DANDROID_TOOLS_PATCH_VENDOR=OFF \
		-DANDROID_TOOLS_USE_BUNDLED_FMT=ON \
		-DANDROID_TOOLS_BUILD_ADBD_ONLY=ON \
		-DANDROID_TOOLS_ADBD_FULLY_STATIC=ON \
		-DANDROID_TOOLS_ADBD_USB=ON
	cmake --build output --target adbd
}

package() {
	install -Dm755 "$builddir"/output/vendor/adbd "$pkgdir"/usr/bin/adbd
	install -Dm644 "$builddir"/LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

openrc() {
	pkgdesc="Android Debug Bridge daemon: OpenRC service (adb over USB and TCP)"
	depends="iproute2-minimal"
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install"

	install -Dm755 "$srcdir"/adbd.initd "$subpkgdir"/etc/init.d/adbd
	install -Dm644 "$srcdir"/adbd.confd "$subpkgdir"/etc/conf.d/adbd
}

