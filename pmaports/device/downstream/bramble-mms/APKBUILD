# Picture messages (MMS) on the Pixel 4a (5G). mmsd-tng fetches and sends the
# messages; this package gives it the MMSC, proxy and APN of the inserted SIM.
maintainer="Kieran Drewett <kieran@drewett.dev>"
pkgname=bramble-mms
pkgver=1
pkgrel=0
pkgdesc="Google Pixel 4a (5G): MMS settings for the inserted SIM"
url="https://github.com/kierandrewett/pmos-google-bramble"
arch="noarch"
license="GPL-3.0-or-later"
depends="
	glib
	mmsd-tng
	mobile-broadband-provider-info
	modemmanager
	python3
	"
source="
	bramble-mms-settings
	bramble-mms-settings.desktop
	"
install_if="device-google-bramble mmsd-tng"
options="!check" # Needs a phone with a SIM

package() {
	install -Dm755 "$srcdir"/bramble-mms-settings "$pkgdir"/usr/libexec/bramble-mms-settings
	install -Dm644 "$srcdir"/bramble-mms-settings.desktop \
		"$pkgdir"/etc/xdg/autostart/bramble-mms-settings.desktop
}
sha512sums="
