# Reference: <https://postmarketos.org/devicepkg>
maintainer="Yurii Bishchuk <astellias@gmail.com>"
# Co-Maintainer: Kieran Drewett <kieran@drewett.dev>
pkgname=device-google-bramble
pkgver=2
pkgrel=25
pkgdesc="Google Pixel 4a (5G) (SM7250 / Snapdragon 765G)"
url="https://wiki.postmarketos.org/wiki/Google_Pixel_4a_(5G)_(google-bramble)"
arch="aarch64"
license="MIT"
depends="
	android-tools
	libdrm
	linux-google-bramble
	make-dynpart-mappings
	mesa-vulkan-freedreno-kgsl
	msm-firmware-loader
	pd-mapper-openrc
	python3
	qrtr
	qrtr-ns-openrc
	rmtfs
	tqftpserv-openrc
	postmarketos-base
	postmarketos-base-downstream
	seatd
	soc-qcom-qbootctl
	"
makedepends="
	devicepkg-dev
	libdrm-dev
	gcc
	"
install="$pkgname.post-install $pkgname.post-upgrade"
subpackages="$pkgname-pipewire:pipewire_config"
source="
	deviceinfo
	modules-initfs
	modules-load.conf
	initfs-hook.sh
	modprobe.conf
	initfs.files
	fix_drm_formats.c
	90-device-google-bramble.rules
	bramble-display.sh
	bramble-dsp.initd
	bramble-modem.initd
	bramble-wlfw-bdf.py
	NetworkManager-conf.d-bramble-unmanaged.conf
	NetworkManager-conf.d-bramble-wowlan.conf
	ucm/sm7250-bolero-snd-card.conf
	ucm/HiFi.conf
	bramble-firmware.initd
	phoc.ini
	10-bramble-env.conf
	bramble-environment.conf
	wireplumber-bramble.conf
	pipewire-bramble-speaker.conf
	"
options="!archcheck !check"

build() {
	devicepkg_build "$startdir" "$pkgname"
	${CC:-gcc} -O2 -fPIC -shared -I/usr/include/libdrm \
		"$srcdir"/fix_drm_formats.c -o libfix_drm_formats.so -ldrm -ldl
}

package() {
	devicepkg_package "$startdir" "$pkgname"

	# Qualcomm MSM DRM fix (FourCC duplicate assert, monotonic clock, udev touch, faccessat)
	install -Dm755 libfix_drm_formats.so "$pkgdir"/usr/lib/libfix_drm_formats.so

	# Ship the alias blacklist in the initramfs too, in /etc/modprobe.d
	# because busybox modprobe (used by mdev there) only reads that path
	install -Dm644 "$srcdir"/initfs.files \
		"$pkgdir"/usr/share/mkinitfs/files/10-$pkgname.files

	# Firmware links and DSP boot
	install -Dm755 "$srcdir"/bramble-firmware.initd "$pkgdir"/etc/init.d/bramble-firmware
	install -Dm755 "$srcdir"/bramble-dsp.initd "$pkgdir"/etc/init.d/bramble-dsp
	install -Dm755 "$srcdir"/bramble-modem.initd "$pkgdir"/etc/init.d/bramble-modem
	install -Dm755 "$srcdir"/bramble-wlfw-bdf.py "$pkgdir"/usr/libexec/bramble-wlfw-bdf
	install -Dm644 "$srcdir"/NetworkManager-conf.d-bramble-unmanaged.conf \
		"$pkgdir"/usr/lib/NetworkManager/conf.d/50-bramble-unmanaged.conf
	install -Dm644 "$srcdir"/NetworkManager-conf.d-bramble-wowlan.conf \
		"$pkgdir"/usr/lib/NetworkManager/conf.d/50-bramble-wowlan.conf

	# ALSA UCM for the sm7250-bolero-snd-card sound card. alsa-lib looks it
	# up by driver name, which the kernel cuts to "sm7250-bolero-s".
	install -Dm644 "$srcdir"/sm7250-bolero-snd-card.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Google/bramble/sm7250-bolero-snd-card.conf
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Google/bramble/HiFi.conf
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/sm7250-bolero-s
	ln -s ../../Google/bramble/sm7250-bolero-snd-card.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm7250-bolero-s/sm7250-bolero-snd-card.conf

	# Global environment profile
	install -Dm755 "$srcdir"/bramble-display.sh "$pkgdir"/etc/profile.d/bramble-display.sh
	install -Dm755 "$srcdir"/bramble-display.sh "$pkgdir"/usr/share/tinydm/env-wayland.d/20-bramble.sh

	# Systemd manager default environment drop-ins (system & user sessions)
	install -Dm644 "$srcdir"/10-bramble-env.conf "$pkgdir"/etc/systemd/system.conf.d/10-bramble.conf
	install -Dm644 "$srcdir"/10-bramble-env.conf "$pkgdir"/etc/systemd/user.conf.d/10-bramble.conf
	install -Dm644 "$srcdir"/bramble-environment.conf "$pkgdir"/etc/environment.d/10-bramble.conf

	# Phosh & Phrog (greeter) display scaling & config
	install -Dm644 "$srcdir"/phoc.ini "$pkgdir"/etc/phosh/phoc.ini
	install -Dm644 "$srcdir"/phoc.ini "$pkgdir"/etc/phrog/phoc.ini
}

pipewire_config() {
	pkgdesc="Google Pixel 4a (5G): PipeWire and WirePlumber settings"
	install_if="$pkgname=$pkgver-r$pkgrel pipewire"
	depends="
		lsp-plugins-ladspa
		pipewire-filter-graph
		pipewire-filter-graph-ladspa
		"

	# No compress-offload device and no camera monitors, see the file
	install -Dm644 "$srcdir"/wireplumber-bramble.conf \
		"$subpkgdir"/usr/share/wireplumber/wireplumber.conf.d/51-bramble.conf
	# Speaker loudness filter (limiter), see the file
	install -Dm644 "$srcdir"/pipewire-bramble-speaker.conf \
		"$subpkgdir"/usr/share/pipewire/pipewire.conf.d/51-bramble-speaker.conf
}
