# Google Pixel 4a (5G) (bramble) udev rules.
# Installed by devicepkg_package as /usr/lib/udev/rules.d/90-device-google-bramble.rules.

# Adreno GPU (KGSL) and the ION allocator it uses for shareable buffers.
# Mesa turnip (Vulkan) and zink (OpenGL on turnip) need both; phoc renders
# with them, so the greeter (user greetd) and the session user need access.
SUBSYSTEM=="kgsl", KERNEL=="kgsl-3d0", MODE="0660", GROUP="video"
KERNEL=="ion", MODE="0660", GROUP="video"

# Haptics: kernel patch 0006 registers the DRV2624 as an FF_RUMBLE input
# device. An FF-only device gets no ID_INPUT from input_id, and feedbackd
# ignores devices without it, so tag it for feedbackd here.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="drv2624-haptics", ENV{ID_INPUT}="1", TAG+="uaccess", ENV{FEEDBACKD_TYPE}="vibra"

# Tap to wake: kernel patch 0009 keeps the touchscreen sensing while the
# screen is off and reports a tap as the power key; patch 0021 lets a single
# tap do it (tap_wake_taps, 1 or 2). Off by default in the driver; write 0
# to double_tap_wake to turn it off again.
ACTION=="add|bind", SUBSYSTEM=="spi", DRIVER=="fts", ATTR{tap_wake_taps}="1", ATTR{double_tap_wake}="1"

# Bluetooth address: the WCN3991 starts unconfigured (kernel patch 0022)
# and bootmac sets an address made from the serial number. bootmac gives
# up after BT_TIMEOUT seconds (default 5) if the controller is not ready;
# the firmware download over the UART can take longer, so allow 30 s.
# udev runs RUN programs after all rules, so this also applies to
# bootmac's own rule.
ACTION=="add", SUBSYSTEM=="bluetooth", KERNEL=="hci0", ENV{BT_TIMEOUT}="30"
