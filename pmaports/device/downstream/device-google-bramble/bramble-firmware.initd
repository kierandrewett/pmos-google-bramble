#!/sbin/openrc-run
# Pixel 4a (5G): add firmware sub-directories that msm-firmware-loader does
# not link (it only links plain files):
# - wlan/qca_cld/WCNSS_qcom_cfg.ini from /vendor/firmware, read by the
#   qcacld-3.0 driver; a copy with WLAN IPA offload off, see below
# - the sub-directories of the modem image (modem_pr, saipan), which the
#   modem asks tqftpserv for as /readonly/firmware/image/<dir>/...

name="bramble-firmware"
description="Link extra Pixel 4a (5G) firmware directories"

depend() {
	need msm-firmware-loader
	before udev
}

start() {
	ebegin "Linking extra bramble firmware directories"
	_base=/run/msm-firmware-loader
	_slot=$(grep -o 'androidboot\.slot_suffix=_[ab]' /proc/cmdline | cut -d= -f2)
	_vendor="$_base/mnt/vendor$_slot/firmware"
	# Without Android's IPACM, the WLAN IPA offload setup on each WLAN
	# connect or disconnect stops mobile data uplink until the next data
	# connection. Turn the offload off (gIPAConfig=0); WLAN data then goes
	# through the host as on other pmOS devices.
	_ini="$_vendor/wlan/qca_cld/WCNSS_qcom_cfg.ini"
	if [ -f "$_ini" ] && [ ! -e "$_base/target/wlan" ]; then
		mkdir -p "$_base/target/wlan/qca_cld"
		sed 's/^gIPAConfig=.*/gIPAConfig=0/' "$_ini" \
			> "$_base/target/wlan/qca_cld/WCNSS_qcom_cfg.ini"
	fi
	for _dir in "$_base/mnt/modem$_slot"/image/*/; do
		[ -d "$_dir" ] || continue
		_name=$(basename "$_dir")
		[ -e "$_base/target/$_name" ] || ln -s "$_dir" "$_base/target/$_name"
	done
	# btqca (hci_qca, WCN3990) asks for qca/crbtfw<rom>.tlv and
	# qca/crnv<rom>.bin, but the vendor BT images are flat in $_vendor.
	if [ ! -e "$_base/target/qca" ]; then
		mkdir -p "$_base/target/qca"
		for _f in "$_vendor"/crbtfw*.tlv "$_vendor"/crnv*.bin; do
			[ -f "$_f" ] || continue
			ln -s "$_f" "$_base/target/qca/${_f##*/}"
		done
	fi
	eend 0
}
