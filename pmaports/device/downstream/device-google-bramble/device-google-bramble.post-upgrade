#!/bin/sh

rc-update -q add msm-firmware-loader sysinit
rc-update -q add bramble-firmware sysinit
# The kernel service locator waits only 300 s after icnss probes for
# pd-mapper, then gives up until the next boot. Start them early.
rc-update -q add qrtr-ns boot
rc-update -q add pd-mapper boot
rc-update -q add tqftpserv default
# Sends the WLAN board data to the WLAN firmware each time it starts.
rc-update -q add bramble-wlfw default
rc-update -q add bramble-modem default
rc-update -q add bramble-dsp default
rc-update -q add bramble-gnss default
# Optional (costs power): enable it once, when it is new, so that removing
# it from the runlevel survives later upgrades.
if [ "$(apk version -t "$2" 2-r29)" = "<" ]; then
	rc-update -q add bramble-ui-boost default
fi
if [ "$(apk version -t "$2" 2-r34)" = "<" ]; then
	rc-update -q add 81voltd default
fi
if [ "$(apk version -t "$2" 2-r36)" = "<" ]; then
	rc-update -q add bramble-mcfg default
fi

exit 0
