maintainer="Kieran Drewett <kieran@drewett.dev>"
# Enrol, verify and manage fingerprints through the fps_hal that runs in the
# bramble-android-hal container. The HIDL client talks to the container's
# hwbinder node; the enrolled templates live in the container's /data.
pkgname=bramble-fingerprint
pkgver=1
pkgrel=5
pkgdesc="Google Pixel 4a (5G): fingerprint enrol/verify/list/remove via the Android HAL"
url="https://github.com/kierandrewett/pmos-google-bramble"
arch="aarch64"
license="GPL-3.0-or-later"
depends="
	bramble-android-hal
	libgbinder
	libglibutil
	"
makedepends="glib-dev libgbinder-dev"
# !tracedeps: the client links against libgbinder, which is only a host library.
options="!check !strip !tracedeps"
builddir="$srcdir"
subpackages="$pkgname-openrc"
install_if="device-google-bramble"
install="$pkgname-openrc.post-install $pkgname-openrc.post-upgrade"
source="
	bramble-fingerprint-unlock.initd
	bramble-fingerprint-unlock.sh
	bramble-fingerprint.initd
	bramble-fingerprint.sh
	fp-enroll-verify.c
	"

build() {
	${CC:-cc} $CFLAGS -Wall -Wextra -o bramble-fingerprint fp-enroll-verify.c \
		$(pkg-config --cflags --libs libgbinder glib-2.0 gobject-2.0) $LDFLAGS
}

package() {
	install -Dm755 "$srcdir"/bramble-fingerprint "$pkgdir"/usr/libexec/bramble-fingerprint
	install -Dm755 "$srcdir"/bramble-fingerprint.sh "$pkgdir"/usr/bin/bramble-fingerprint
	install -Dm755 "$srcdir"/bramble-fingerprint-unlock.sh "$pkgdir"/usr/libexec/bramble-fingerprint-unlock
}

openrc() {
	pkgdesc="Google Pixel 4a (5G): fingerprint key setup at boot (OpenRC)"
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="bramble-android-hal-openrc elogind glib setpriv"

	install -Dm755 "$srcdir"/bramble-fingerprint.initd "$subpkgdir"/etc/init.d/bramble-fingerprint
	install -Dm755 "$srcdir"/bramble-fingerprint-unlock.initd \
		"$subpkgdir"/etc/init.d/bramble-fingerprint-unlock
}
