b5409d71687482d2f538ea077061e4c78b0f984a73d44d85d9e9c2053cb00faf0d7f32d99aa9694461f7d420c3b7c869ac3734cbf34f934d5eb8754016354b65  bramble-fingerprint.sh
3ec962ff53830ca3cac3675929b99a72fec9c6f2ae7c6552a23d0292119f0936c9225d6cf75be4013e13a3edc92700163ab45d1829e40ab6d47585455a5a2e6f  fp-enroll-verify.c
"
