76144fe06893cd6b3c69d9cdddc0ae12b551db0bc3fda21bebde5f4c49d24925c08ff9ff0cd7d9f2c1968c3e56997becc3bac57fc639c81acafed0fb19b46310  0001-turnip-kgsl-report-DRM-nodes-of-the-display-device.patch
"
