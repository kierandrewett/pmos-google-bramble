maintainer="Kieran Drewett <kieran@drewett.dev>"
# Runs the phone's own Android vendor HALs (camera, fingerprint) in a
# container with the Halium 14 system image. bramble-camera-pipewire offers
# the cameras to camera apps (GNOME Snapshot) as PipeWire camera nodes;
# bramble-camera takes full-resolution photos from the command line.
#
# bramble-camera-ndk and bramble-camera-proxy run inside the container
# (bionic, Android 14). pmbootstrap has no Android NDK, so they are built
# from tools/android-helpers/ in the pmos-google-bramble repository with
# tools/android-helpers/build.sh and shipped prebuilt here.
pkgname=bramble-android-hal
pkgver=1
pkgrel=13
pkgdesc="Google Pixel 4a (5G): Android vendor HAL container and camera tool"
url="https://github.com/kierandrewett/pmos-google-bramble"
arch="aarch64"
license="GPL-3.0-or-later"
depends="
	device-mapper
	halium-gsi-34
	pipewire-libs
	setpriv
	util-linux-misc
	"
makedepends="pipewire-dev"
install_if="device-google-bramble"
# !tracedeps: the helpers for the container link against Android (bionic)
# libraries, which do not exist on the host.
options="!check !strip !tracedeps"
builddir="$srcdir"
subpackages="$pkgname-openrc"
install="$pkgname-openrc.post-install"
source="
	90-bramble-android.rules
	bramble-android.initd
	bramble-camera-pipewire.c
	bramble-camera-pipewire.desktop
	bramble-android.sh
	bramble-camera-ndk
	bramble-camera-proxy
	bramble-camera.sh
	bramble.rc
	init.bramble.rc
	vendor-init.list
	"

build() {
	${CC:-cc} $CFLAGS -Wall -Wextra -o bramble-camera-pipewire bramble-camera-pipewire.c \
		$(pkg-config --cflags --libs libpipewire-0.3) $LDFLAGS
}

package() {
	install -Dm755 "$srcdir"/bramble-camera-pipewire "$pkgdir"/usr/libexec/bramble-camera-pipewire
	install -Dm644 "$srcdir"/bramble-camera-pipewire.desktop \
		"$pkgdir"/etc/xdg/autostart/bramble-camera-pipewire.desktop
	install -Dm755 "$srcdir"/bramble-android.sh "$pkgdir"/usr/libexec/bramble-android
	install -Dm755 "$srcdir"/bramble-camera.sh "$pkgdir"/usr/bin/bramble-camera
	install -Dm755 "$srcdir"/bramble-android.initd "$pkgdir"/etc/init.d/bramble-android
	install -Dm644 "$srcdir"/90-bramble-android.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-bramble-android.rules

	local share="$pkgdir"/usr/share/bramble-android
	install -Dm644 -t "$share" \
		"$srcdir"/bramble.rc \
		"$srcdir"/init.bramble.rc \
		"$srcdir"/vendor-init.list
	install -Dm755 -t "$share"/bin \
		"$srcdir"/bramble-camera-ndk \
		"$srcdir"/bramble-camera-proxy

	install -dm700 "$pkgdir"/var/lib/bramble-android
}

openrc() {
	default_openrc
	install_if="openrc $pkgname=$pkgver-r$pkgrel"
}
