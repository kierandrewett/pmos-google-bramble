+		 */
+		fw_dir = opendir_firmware(".", path, sizeof(path));
+		if (!fw_dir) {
+			warn("no remoteproc class and no firmware directory");
+			return -1;
+		}
+		pd_add_jsons_from_dir(json_set, fw_dir, path);
+		closedir(fw_dir);
+		return 0;
 	}
 
 	class_dir = fdopendir(class_fd);
