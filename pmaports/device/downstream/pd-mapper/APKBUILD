pkgname=pd-mapper
pkgver=1.1
pkgrel=0
pkgdesc="Qualcomm protection domain mapper (service locator server)"
url="https://github.com/linux-msm/pd-mapper"
arch="aarch64 armv7"
license="BSD-3-Clause"
makedepends="qrtr-dev xz-dev"
subpackages="$pkgname-openrc"
source="
	pd-mapper-$pkgver.tar.gz::https://github.com/linux-msm/pd-mapper/archive/refs/tags/v$pkgver.tar.gz
	0001-find-domain-maps-without-the-remoteproc-class.patch
	pd-mapper.initd
	"
options="!check"

build() {
	make prefix=/usr
}

package() {
	install -Dm755 pd-mapper "$pkgdir"/usr/bin/pd-mapper
	install -Dm755 "$srcdir"/pd-mapper.initd "$pkgdir"/etc/init.d/pd-mapper
}
