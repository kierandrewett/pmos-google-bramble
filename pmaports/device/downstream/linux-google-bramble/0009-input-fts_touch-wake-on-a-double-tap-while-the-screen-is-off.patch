+/* Tap to wake: "echo 1 > double_tap_wake" (applies at the next screen off) */
+static ssize_t double_tap_wake_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	struct fts_ts_info *info = dev_get_drvdata(dev);
+
+	return scnprintf(buf, PAGE_SIZE, "%d\n", info->tap_wake_enabled);
+}
+
+static ssize_t double_tap_wake_store(struct device *dev,
+				     struct device_attribute *attr,
+				     const char *buf, size_t count)
+{
+	struct fts_ts_info *info = dev_get_drvdata(dev);
+	bool enable;
+
+	if (kstrtobool(buf, &enable) < 0)
+		return -EINVAL;
+
+	WRITE_ONCE(info->tap_wake_enabled, enable);
+	return count;
+}
