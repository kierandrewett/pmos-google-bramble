@@ -4363,6 +4388,94 @@
   * the FIFO and dispatch them to the proper event handler according the event
   * ID
   */
+/*
+ * Tap to wake.
+ *
+ * The controller's own gesture mode does not report a double tap with this
+ * firmware (Android detects taps on the ADSP instead), but normal touch
+ * reporting keeps working with the panel powered off. So while the screen is
+ * off and double_tap_wake is set, the controller keeps scanning (mutual sense
+ * only), its interrupt stays armed as a wakeup source, and the driver finds a
+ * double tap in the touch events and reports KEY_POWER, which Phosh uses to
+ * turn the screen on. No touches are reported while the screen is off.
+ */
+#define FTS_TAP_MAX_MS		400	/* longest contact that counts as a tap */
+#define FTS_TAP_GAP_MS		500	/* longest pause between the two taps */
+#define FTS_TAP_SLOP		60	/* most a tap may move, in pixels */
+#define FTS_DOUBLE_TAP_SLOP	200	/* most the 2nd tap may be from the 1st */
+
+static bool fts_tap_wake_far(int x0, int y0, int x1, int y1, int slop)
+{
+	int dx = x1 - x0, dy = y1 - y0;
+
+	return dx * dx + dy * dy > slop * slop;
+}
+
+/* Feed one FIFO event to the double tap detector */
+static void fts_tap_wake_event(struct fts_ts_info *info, const u8 *event)
+{
+	struct fts_tap_wake *tap = &info->tap;
+	u8 type = event[1] & 0x0F;
+	u8 id = (event[1] & 0xF0) >> 4;
+	int x = ((event[3] & 0x0F) << 8) | event[2];
+	int y = (event[4] << 4) | ((event[3] & 0xF0) >> 4);
+	ktime_t now = ktime_get();
+
+	switch (event[0] >> 4) {
+	case EVT_ID_ENTER_POINT >> 4:
+		if (tap->fingers) {
+			/* more than one finger is not a tap */
+			tap->valid = false;
+		} else {
+			tap->valid = type == TOUCH_TYPE_FINGER ||
+				     type == TOUCH_TYPE_GLOVE;
+			tap->down_time = now;
+			tap->x = x;
+			tap->y = y;
+			if (tap->taps &&
+			    (ktime_ms_delta(now, tap->up_time) > FTS_TAP_GAP_MS ||
+			     fts_tap_wake_far(tap->first_x, tap->first_y, x, y,
+					      FTS_DOUBLE_TAP_SLOP)))
+				tap->taps = 0;
+		}
+		__set_bit(id, &tap->fingers);
+		break;
+
+	case EVT_ID_MOTION_POINT >> 4:
+		if (fts_tap_wake_far(tap->x, tap->y, x, y, FTS_TAP_SLOP))
+			tap->valid = false;
+		break;
+
+	case EVT_ID_LEAVE_POINT >> 4:
+		/* ignore touches that started before the screen went off */
+		if (!__test_and_clear_bit(id, &tap->fingers) || tap->fingers)
+			break;
+
+		if (!tap->valid ||
+		    ktime_ms_delta(now, tap->down_time) > FTS_TAP_MAX_MS) {
+			tap->taps = 0;
+			break;
+		}
+
+		if (++tap->taps == 1) {
+			tap->first_x = tap->x;
+			tap->first_y = tap->y;
+			tap->up_time = now;
+			break;
+		}
+
+		tap->taps = 0;
+		pr_info("%s: double tap, waking the screen\n", __func__);
+		mutex_lock(&info->input_report_mutex);
+		input_report_key(info->input_dev, KEY_POWER, 1);
+		input_sync(info->input_dev);
+		input_report_key(info->input_dev, KEY_POWER, 0);
+		input_sync(info->input_dev);
+		mutex_unlock(&info->input_report_mutex);
+		break;
+	}
+}
+
 static irqreturn_t fts_interrupt_handler(int irq, void *handle)
 {
 	struct fts_ts_info *info = handle;
@@ -4375,6 +4488,7 @@
 	unsigned char events_remaining = 0;
