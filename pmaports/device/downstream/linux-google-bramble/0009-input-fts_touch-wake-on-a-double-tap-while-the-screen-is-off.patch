 	struct device           *dev;	/* Pointer to the device */
 #ifdef I2C_INTERFACE
@@ -477,6 +488,10 @@
 
 	/* switches for features */
 	int gesture_enabled;	/* Gesture during suspend */
+	bool tap_wake_enabled;	/* double_tap_wake: wake on a double tap */
+	bool tap_wake_armed;	/* screen off, still sensing for a double tap */
+	bool tap_wake_suspended; /* system suspend disabled the armed irq */
+	struct fts_tap_wake tap; /* double tap detector */
 	int glove_enabled;	/* Glove mode */
 	int charger_enabled;	/* Charger mode */
 	int stylus_enabled;	/* Stylus mode */
--- a/drivers/input/touchscreen/fts_touch/fts.c	2026-10-23 17:06:01.941835919 +0100
+++ b/drivers/input/touchscreen/fts_touch/fts.c	2026-10-23 17:07:08.490244748 +0100
