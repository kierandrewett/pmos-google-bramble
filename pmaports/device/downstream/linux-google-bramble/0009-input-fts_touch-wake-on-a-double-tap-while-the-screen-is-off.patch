 	 * executing, before acquiring the mutex. If so, simply return.
+	 * When tap to wake is armed the bus stays with the AP: read the FIFO
+	 * without a bus reference, which would resume the controller.
 	 */
-	if (fts_set_bus_ref(info, FTS_BUS_REF_IRQ, true) < 0) {
+	if (!tap_wake && fts_set_bus_ref(info, FTS_BUS_REF_IRQ, true) < 0) {
 		fts_set_bus_ref(info, FTS_BUS_REF_IRQ, false);
 		return IRQ_HANDLED;
 	}
@@ -4418,6 +4534,11 @@
 
 			eventId = evt_data[0] >> 4;
 
+			if (tap_wake) {
+				fts_tap_wake_event(info, evt_data);
+				continue;
+			}
+
 			/* Ensure event ID is within bounds */
 			if (eventId < NUM_EVT_ID) {
 				processed_pointer_event = info->event_dispatch_table[eventId](
@@ -4426,6 +4547,11 @@
 		}
 	}
 
+	if (tap_wake) {
+		pm_qos_update_request(&info->pm_qos_req, PM_QOS_DEFAULT_VALUE);
+		return IRQ_HANDLED;
+	}
+
 #if IS_ENABLED(CONFIG_TOUCHSCREEN_OFFLOAD)
 	if (!info->offload.offload_running) {
 #endif
@@ -5476,14 +5602,22 @@
 	if (!info->sensor_sleep)
 		return;
 
+	if (READ_ONCE(info->tap_wake_armed)) {
+		/* the bus never left the AP: stop the double tap detection */
+		fts_enableInterrupt(false);
+		synchronize_irq(info->client->irq);
+		disable_irq_wake(info->client->irq);
+		WRITE_ONCE(info->tap_wake_armed, false);
+	} else {
 #if IS_ENABLED(CONFIG_TOUCHSCREEN_TBN)
-	if (info->tbn)
-		tbn_request_bus(info->tbn);
+		if (info->tbn)
+			tbn_request_bus(info->tbn);
 #endif
 
-	fts_set_switch_gpio(info, FTS_SWITCH_GPIO_VALUE_AP_MASTER);
+		fts_set_switch_gpio(info, FTS_SWITCH_GPIO_VALUE_AP_MASTER);
 
-	fts_pinctrl_setup(info, true);
+		fts_pinctrl_setup(info, true);
+	}
 
 	__pm_wakeup_event(info->wakesrc, jiffies_to_msecs(HZ));
 
@@ -5541,6 +5675,22 @@
 
 	info->resume_bit = 0;
 
+	if (READ_ONCE(info->tap_wake_enabled)) {
+		/*
+		 * Tap to wake: keep the controller scanning, with the bus and
+		 * the interrupt (as a wakeup source) on the AP, instead of
+		 * sense off and handing the bus to the ADSP.
+		 */
+		release_all_touches(info);
+		setScanMode(SCAN_MODE_ACTIVE, ACTIVE_MULTI_TOUCH);
+		memset(&info->tap, 0, sizeof(info->tap));
+		enable_irq_wake(info->client->irq);
+		WRITE_ONCE(info->tap_wake_armed, true);
+		info->sensor_sleep = true;
+		__pm_relax(info->wakesrc);
+		return;
+	}
+
 	fts_mode_handler(info, 0);
 
 	release_all_touches(info);
@@ -6353,6 +6503,8 @@
 	input_set_abs_params(info->input_dev, ABS_MT_ORIENTATION, -4096, 4096,
 			     0, 0);
 
+	input_set_capability(info->input_dev, EV_KEY, KEY_POWER);
+
 #ifdef GESTURE_MODE
 	input_set_capability(info->input_dev, EV_KEY, KEY_WAKEUP);
 
@@ -6747,13 +6899,24 @@
 		return -EBUSY;
 	}
 
+	if (READ_ONCE(info->tap_wake_armed)) {
+		/* keep the irq wake, but handle it after the SPI bus resumed */
+		fts_enableInterrupt(false);
+		info->tap_wake_suspended = true;
+	}
+
 	return 0;
 }
 
