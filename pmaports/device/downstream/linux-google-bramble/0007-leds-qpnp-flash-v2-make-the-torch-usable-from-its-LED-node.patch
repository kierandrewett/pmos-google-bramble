From: postmarketOS <bramble@localhost>
Subject: [PATCH] leds: qpnp-flash-v2: make the torch usable from its LED node alone

Phosh's torch toggle picks the first LED named *:torch* or *:flash* and only
writes its brightness. On bramble that is led:flash_0, the 1.5 A camera
flash, and on this driver a torch node only programs its current; the
module is enabled through a led:switch_N node.

- Register the camera flash nodes as led:strobe_N (the names come from
  the stock dtbo, so rename in the driver) and accept that prefix in
  brightness_set, so led:torch_0 is found first.
- When a torch node's brightness changes, drive the switch dedicated to it
  (led_mask == BIT(id)). Shared switches are left alone, and flash nodes on
  the same channel are disarmed first, so a torch request can never fire
  the camera flash.
- Report brightness 0 at probe instead of the default current from the
  DT (qcom,current-ma). The LEDs are off at probe, and Phosh read the
  default current (300 of 500) as "torch on at 60%".

---
--- a/drivers/leds/leds-qpnp-flash-v2.c	2026-10-23 17:49:32.020190025 +0100
+++ b/drivers/leds/leds-qpnp-flash-v2.c	2026-10-23 17:49:32.153191628 +0100
@@ -1901,6 +1901,53 @@
 }
 EXPORT_SYMBOL_GPL(qpnp_flash_leds_prepare);
 
+/*
+ * A torch node only programs its current in qpnp_flash_led_node_set(); the
+ * module is enabled through a switch node whose led_mask covers it. Drive the
+ * switch dedicated to this node (led_mask == BIT(id)) so a plain led:torch_N
+ * brightness write lights the LED. Shared switches are left alone: enabling
+ * one would also light any other armed node on it, such as a flash node.
+ */
+static void qpnp_flash_led_torch_switch_update(struct qpnp_flash_led *led,
+					struct flash_node_data *fnode, bool on)
+{
+	struct flash_switch_data *snode;
+	bool others_on;
+	int i, j, rc;
+
+	for (i = 0; i < led->num_snodes; i++) {
+		snode = &led->snode[i];
+		if (snode->led_mask != BIT(fnode->id))
+			continue;
+
+		if (on) {
+			/* never let a torch request fire an armed flash node */
+			for (j = 0; j < led->num_fnodes; j++)
+				if (led->fnode[j].type == FLASH_LED_TYPE_FLASH &&
+				    (snode->led_mask & BIT(led->fnode[j].id)))
+					led->fnode[j].led_on = false;
+			rc = qpnp_flash_led_switch_set(snode, true);
+			if (rc < 0)
+				pr_err("Failed to enable torch switch, rc=%d\n",
+					rc);
+			continue;
+		}
+
+		fnode->led_on = false;
+		others_on = false;
+		for (j = 0; j < led->num_fnodes; j++)
+			if (led->fnode[j].led_on &&
+					(snode->led_mask & BIT(led->fnode[j].id)))
+				others_on = true;
+		if (others_on)
+			continue;
+
+		rc = qpnp_flash_led_switch_set(snode, false);
+		if (rc < 0)
+			pr_err("Failed to disable torch switch, rc=%d\n", rc);
+	}
+}
+
 static void qpnp_flash_led_brightness_set(struct led_classdev *led_cdev,
 						enum led_brightness value)
 {
@@ -1912,11 +1959,15 @@
 	/*
 	 * strncmp() must be used here since a prefix comparison is required
 	 * in order to support names like led:switch_0 and led:flash_1.
+	 * led:strobe_N is a flash node renamed so userspace does not treat it
+	 * as a torch.
 	 */
 	if (!strncmp(led_cdev->name, "led:switch", strlen("led:switch"))) {
 		snode = container_of(led_cdev, struct flash_switch_data, cdev);
 		led = dev_get_drvdata(&snode->pdev->dev);
 	} else if (!strncmp(led_cdev->name, "led:flash", strlen("led:flash")) ||
+			!strncmp(led_cdev->name, "led:strobe",
+						strlen("led:strobe")) ||
 			!strncmp(led_cdev->name, "led:torch",
 						strlen("led:torch"))) {
 		fnode = container_of(led_cdev, struct flash_node_data, cdev);
@@ -1935,6 +1986,8 @@
 			pr_err("Failed to set flash LED switch rc=%d\n", rc);
 	} else if (fnode) {
 		qpnp_flash_led_node_set(fnode, value);
+		if (fnode->type == FLASH_LED_TYPE_TORCH)
+			qpnp_flash_led_torch_switch_update(led, fnode, value > 0);
 	}
 
 	spin_unlock(&led->lock);
@@ -2267,7 +2320,11 @@
 		if (val > fnode->max_current)
 			val = fnode->max_current;
 		fnode->current_ma = val;
-		fnode->cdev.brightness = val;
+		/*
+		 * Nothing is lit at probe. Reporting the default current as
+		 * the brightness made Phosh show the torch as on.
+		 */
+		fnode->cdev.brightness = 0;
 	} else if (rc != -EINVAL) {
 		pr_err("Unable to read operational current, rc=%d\n", rc);
 		return rc;
@@ -2316,6 +2373,24 @@
 	if (rc < 0)
 		return rc;
 
+	/*
+	 * Desktop shells (Phosh) treat the first LED named *:flash* or *:torch*
+	 * as the torch. Register the camera flash nodes as led:strobe_N so the
+	 * torch nodes are found instead; brightness_set accepts that prefix.
+	 * Done here rather than in the DT because the names come from the
+	 * stock dtbo.
+	 */
+	if (fnode->type == FLASH_LED_TYPE_FLASH &&
+	    !strncmp(fnode->cdev.name, "led:flash", strlen("led:flash"))) {
+		const char *name = devm_kasprintf(&led->pdev->dev, GFP_KERNEL,
+				"led:strobe%s",
+				fnode->cdev.name + strlen("led:flash"));
+
+		if (!name)
+			return -ENOMEM;
+		fnode->cdev.name = name;
+	}
+
 	rc = led_classdev_register(&led->pdev->dev, &fnode->cdev);
 	if (rc < 0) {
 		pr_err("Unable to register led node %d\n", fnode->id);
