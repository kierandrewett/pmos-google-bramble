builddir="$srcdir/android_kernel_google_redbull-$_commit"
_outdir="out"
_config="config-${pkgname#linux-}.$arch"
_flavor="${pkgname#linux-}"

# Built with clang 16 (the oldest clang in Alpine, closest to the Android
# clang 12 that LineageOS uses). This build is verified on the device: it
# boots LineageOS recovery with our modules. The default clang was not
# verified on the device.
# LLVM=1 takes clang, llvm-ar, llvm-nm, ... from PATH; ld.lld comes from lld.
_llvm_path="/usr/lib/llvm16/bin"

prepare() {
	default_prepare
	export PATH="$_llvm_path:$PATH"
	export LLVM=1
	export REPLACE_GCCH=0
	sed -i '/dtbo-redfin/d; /dtbo-barbet/d' "$builddir"/scripts/Makefile.dtbo
	sed -i '/dtbo_redfin/d; /dtbo_barbet/d' "$builddir"/arch/arm64/Makefile
	. downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	export PATH="$_llvm_path:$PATH"
	make -j"${JOBS:-4}" O="$_outdir" ARCH="$_carch" LLVM=1 KBUILD_LDFLAGS="--threads=4" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))"-postmarketOS
}

package() {
	export PATH="$_llvm_path:$PATH"
	export KERNEL_IMAGE_NAME="Image.lz4"
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"${pkgname#linux-}" "$_outdir"
	make -j"${JOBS:-4}" O="$_outdir" ARCH="$_carch" LLVM=1 \
		INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1 modules_install
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	# The bootloader picks the matching SoC revision from a list of
	# concatenated DTBs, like LineageOS does in vendor_boot.
	_dts="$builddir/$_outdir/arch/$_carch/boot/dts/google/qcom-base"
	mkdir -p "$pkgdir"/boot/dtbs/google
	cat "$_dts"/lito-v2.dtb "$_dts"/lito.dtb > "$pkgdir"/boot/dtbs/google/lito-redbull.dtb

	# The dtbo partition keeps Google's stock overlay. The dtbo built from
	# this tree is not installed: with it the kernel hangs at the boot logo
	# (tested 2026-10-23), so device-specific DT changes go into the base
	# DTB above, which the stock overlay is applied on top of.
}
