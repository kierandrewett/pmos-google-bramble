# Sensors (accelerometer, light, proximity) on the Pixel 4a (5G): the Hexagon
# FS service the sensors DSP needs, the udev tags that let iio-sensor-proxy
# find the sensors, and a demo command that prints readings.
maintainer="Kieran Drewett <kieran@drewett.dev>"
pkgname=bramble-sensors
pkgver=1
pkgrel=1
pkgdesc="Google Pixel 4a (5G): sensors DSP service and demo"
url="https://wiki.postmarketos.org/wiki/Google_Pixel_4a_(5G)_(google-bramble)"
arch="aarch64"
license="MIT"
depends="
	hexagonrpcd>=99990.4.0
	libssc
	"
install="$pkgname-openrc.post-install"
subpackages="$pkgname-openrc"
source="
	71-bramble-sensors.rules
	bramble-sensors-demo
	bramble-sensors.initd
	"
install_if="device-google-bramble"
options="!check" # No test suite

package() {
	install -Dm644 "$srcdir"/71-bramble-sensors.rules "$pkgdir"/usr/lib/udev/rules.d/71-bramble-sensors.rules
	install -Dm755 "$srcdir"/bramble-sensors-demo "$pkgdir"/usr/bin/bramble-sensors-demo
}

openrc() {
	pkgdesc="Google Pixel 4a (5G): sensors DSP OpenRC service"
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="
		msm-firmware-loader
		pd-mapper-openrc
		qrtr-ns-openrc
		"

	install -Dm755 "$srcdir"/bramble-sensors.initd "$subpkgdir"/etc/init.d/bramble-sensors
}

