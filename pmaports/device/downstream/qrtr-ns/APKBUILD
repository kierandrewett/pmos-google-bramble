# Maintainer: Kieran Drewett <kieran@drewett.dev>
pkgname=qrtr-ns
pkgver=1.2
pkgrel=0
pkgdesc="QRTR name service for downstream Qualcomm kernels without the in-kernel name service"
url="https://github.com/linux-msm/qrtr"
arch="aarch64 armv7"
license="BSD-3-Clause"
depends="qrtr-libs~$pkgver"
makedepends="linux-headers meson qrtr-dev"
subpackages="$pkgname-openrc"
source="
	qrtr-$pkgver.tar.gz::https://github.com/linux-msm/qrtr/archive/refs/tags/v$pkgver.tar.gz
	qrtr-ns.initd
	"
builddir="$srcdir/qrtr-$pkgver"
options="!check"

# Alpine's qrtr builds without qrtr-ns, because kernels since 5.7 run the
# name service in the kernel. Downstream 4.x kernels still need it in
# userspace (Android starts /vendor/bin/qrtr-ns). Only qrtr-ns is installed;
# it uses libqrtr from Alpine's qrtr-libs of the same version.
build() {
	abuild-meson \
		-Dqrtr-ns=enabled \
		-Dsystemd-service=disabled \
		. output
	meson compile -C output
}

package() {
	install -Dm755 output/src/qrtr-ns "$pkgdir"/usr/bin/qrtr-ns
	install -Dm755 "$srcdir"/qrtr-ns.initd "$pkgdir"/etc/init.d/qrtr-ns
}
sha512sums="
