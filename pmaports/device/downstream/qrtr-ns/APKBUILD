0f41a94e6f7c0a67889f230f0519fd97a8097eee762ac09d82ebe4b1893ce97474d885350856ffae7fd09452c17b3cba323b5cc92cb2ebee52c6fd26aa0140cc  qrtr-ns.initd
"
