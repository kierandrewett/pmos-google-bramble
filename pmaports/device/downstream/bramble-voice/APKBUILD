d303e1b52c6f6475c204c511a582481f4f02715ea3fce9b5becfb55897a3180aefc7ca7c9c7bdf06a5fee492d44d0d8ad4d12572881cb6ea81a6acf3f1ed5cd2  bramble-voiced.initd
a57afe39ef235a7f0223fdb363e44564d6127d7d3831791797c91ab9e60a8acc7a13b66c802abddedf95f4f0ed1b31c3b95f288f60276e8ec9c37fffde0bb17a  bramble-voiced.confd
"
