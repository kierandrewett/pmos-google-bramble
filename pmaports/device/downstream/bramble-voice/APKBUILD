# Voice call audio on the Pixel 4a (5G). ModemManager connects the call; this
# daemon starts the audio DSP's voice path while a call is active: voice
# calibration (through bramble-acdb in the Android HAL container), routing,
# microphone and the voice PCM.
maintainer="Kieran Drewett <kieran@drewett.dev>"
pkgname=bramble-voice
pkgver=1
pkgrel=1
pkgdesc="Google Pixel 4a (5G): voice call audio"
url="https://github.com/kierandrewett/pmos-google-bramble"
arch="noarch"
license="GPL-3.0-or-later"
depends="
	alsa-lib
	alsa-utils
	bramble-android-hal
	glib
	modemmanager
	pulseaudio-utils
	python3
	wireplumber
	"
install="$pkgname-openrc.post-install"
subpackages="$pkgname-openrc"
source="
	bramble-voiced
	bramble-voiced.initd
	bramble-voiced.confd
	"
install_if="device-google-bramble"
options="!check" # Needs a phone with a call

package() {
	install -Dm755 "$srcdir"/bramble-voiced "$pkgdir"/usr/libexec/bramble-voiced
	install -Dm644 "$srcdir"/bramble-voiced.confd "$pkgdir"/etc/conf.d/bramble-voiced
}

openrc() {
	pkgdesc="Google Pixel 4a (5G): voice call audio OpenRC service"
	install_if="$pkgname=$pkgver-r$pkgrel openrc"

	install -Dm755 "$srcdir"/bramble-voiced.initd "$subpkgdir"/etc/init.d/bramble-voiced
}
sha512sums="
