From: Kieran Drewett <kieran@drewett.dev>
Subject: [PATCH] translate: fall back to the firmware path without remoteproc

Downstream Qualcomm kernels boot the modem with subsys-pil and have no
/sys/class/remoteproc, so every /readonly/firmware/image/ request was
rejected. Look the file up in the firmware search path from sysfs, then
in FIRMWARE_BASE. Also initialise fw_sysfs_path, which was read
uninitialised when the sysfs file is missing.

diff --git a/translate.c b/translate.c
index 246b82d..b215838 100644
--- a/translate.c
+++ b/translate.c
@@ -72,7 +72,7 @@ static int translate_readonly(const char *file)
 	char *firmware_path;
 	char firmware_attr[32];
 	char path[PATH_MAX];
-	char fw_sysfs_path[PATH_MAX];
+	char fw_sysfs_path[PATH_MAX] = "";
 	struct dirent *de;
 	int firmware_fd;
 	DIR *class_dir;
@@ -84,7 +84,28 @@ static int translate_readonly(const char *file)
 
 	class_fd = open("/sys/class/remoteproc", O_RDONLY | O_DIRECTORY);
 	if (class_fd < 0) {
-		warn("failed to open remoteproc class");
+		/*
+		 * Downstream kernels boot the DSPs with subsys-pil and have no
+		 * remoteproc class. Look the file up directly in the firmware
+		 * search path, then in FIRMWARE_BASE.
+		 */
+		if (strlen(fw_sysfs_path) > 0 &&
+		    strlen(fw_sysfs_path) + 1 + strlen(file) + 1 < sizeof(path)) {
+			strcpy(path, fw_sysfs_path);
+			strcat(path, "/");
+			strcat(path, file);
+			fd = open_maybe_compressed(path);
+			if (fd >= 0)
+				return fd;
+		}
+		if (strlen(FIRMWARE_BASE) + strlen(file) + 1 < sizeof(path)) {
+			strcpy(path, FIRMWARE_BASE);
+			strcat(path, file);
+			fd = open_maybe_compressed(path);
+			if (fd >= 0)
+				return fd;
+		}
+		warn("no remoteproc class and %s not in the firmware path", file);
 		return -1;
 	}
 
